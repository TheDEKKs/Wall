// Typing animation for hero section
const heroTitle = document.getElementById('hero-title');
const heroSubtitle = document.getElementById('hero-subtitle');

const titleText = 'WALL';
const subtitleText = 'ПИШИ НА СТЕНЫ';

let titleIndex = 0;
let subtitleIndex = 0;

// Type title
function typeTitle() {
    if (titleIndex < titleText.length) {
        heroTitle.textContent += titleText.charAt(titleIndex);
        titleIndex++;
        setTimeout(typeTitle, 200);
    } else {
        // Start typing subtitle after title is done
        setTimeout(typeSubtitle, 500);
    }
}

// Type subtitle
function typeSubtitle() {
    if (subtitleIndex < subtitleText.length) {
        heroSubtitle.textContent += subtitleText.charAt(subtitleIndex);
        subtitleIndex++;
        setTimeout(typeSubtitle, 100);
    } else {
        // Add blinking cursor effect
        heroSubtitle.style.borderRight = '2px solid #fff';
        setInterval(() => {
            heroSubtitle.style.borderRight = 
                heroSubtitle.style.borderRight === '2px solid #fff' 
                ? '2px solid transparent' 
                : '2px solid #fff';
        }, 500);
    }
}

// Start typing animation when page loads
window.addEventListener('load', () => {
    setTimeout(typeTitle, 500);
});

// Smooth scroll for scroll indicator
document.querySelector('.scroll-indicator')?.addEventListener('click', () => {
    const aboutSection = document.querySelector('.about-section');
    aboutSection?.scrollIntoView({ behavior: 'smooth' });
});

// Parallax effect for section numbers
window.addEventListener('scroll', () => {
    const scrolled = window.pageYOffset;
    const sectionNumbers = document.querySelectorAll('.section-number');
    
    sectionNumbers.forEach((number) => {
        const speed = 0.5;
        const yPos = -(scrolled * speed);
        number.style.transform = `translateY(${yPos}px)`;
    });
});

// Intersection Observer for fade-in animations
const observerOptions = {
    threshold: 0.2,
    rootMargin: '0px 0px -100px 0px'
};

const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
        if (entry.isIntersecting) {
            entry.target.style.opacity = '1';
            entry.target.style.transform = 'translateY(0)';
        }
    });
}, observerOptions);

// Observe elements for animation
document.addEventListener('DOMContentLoaded', () => {
    const animatedElements = document.querySelectorAll(
        '.feature-card, .social-card, .about-text, .warning-box'
    );
    
    animatedElements.forEach(el => {
        el.style.opacity = '0';
        el.style.transform = 'translateY(30px)';
        el.style.transition = 'opacity 0.6s ease, transform 0.6s ease';
        observer.observe(el);
    });
});

// Glitch effect on hover for title
heroTitle?.addEventListener('mouseenter', () => {
    let glitchInterval = setInterval(() => {
        heroTitle.style.transform = `translate(${Math.random() * 4 - 2}px, ${Math.random() * 4 - 2}px)`;
    }, 50);
    
    setTimeout(() => {
        clearInterval(glitchInterval);
        heroTitle.style.transform = 'translate(0, 0)';
    }, 300);
});

// CTA Button click handler
document.querySelector('.cta-button')?.addEventListener('click', () => {
    // Here you can add navigation to registration/login page
    console.log('Starting Wall creation...');
    // Example: window.location.href = '/register';
});

// Add sound effect on button hover (optional)
const buttons = document.querySelectorAll('.cta-button, .social-card');
buttons.forEach(button => {
    button.addEventListener('mouseenter', () => {
        // You can add audio feedback here if desired
        button.style.transition = 'all 0.2s ease';
    });
});

// Random glitch effect on page (EVA style)
setInterval(() => {
    if (Math.random() > 0.95) {
        document.body.style.filter = 'hue-rotate(180deg)';
        setTimeout(() => {
            document.body.style.filter = 'none';
        }, 50);
    }
}, 3000);

// Console easter egg
console.log('%c WALL SYSTEM INITIALIZED ', 'background: #9933ff; color: #fff; font-size: 20px; padding: 10px;');
console.log('%c VERSION 1.0.0 ', 'background: #000; color: #00ff00; font-size: 14px; padding: 5px;');
console.log('%c NERV APPROVED ', 'background: #ff6600; color: #000; font-size: 12px; padding: 5px;');