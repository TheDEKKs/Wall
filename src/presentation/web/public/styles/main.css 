/* Evangelion-inspired minimal design */

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

:root {
    /* EVA Color Palette */
    --eva-purple: #9933ff;
    --eva-orange: #ff6600;
    --eva-green: #00ff00;
    --eva-red: #ff0000;
    --bg-dark: #0a0a0a;
    --bg-darker: #000000;
    --text-primary: #ffffff;
    --text-secondary: #cccccc;
    --text-muted: #666666;
    --border-color: #333333;
    --warning-yellow: #ffff00;
}

body {
    font-family: 'Courier New', monospace;
    background: var(--bg-dark);
    color: var(--text-primary);
    overflow-x: hidden;
    line-height: 1.6;
}

.section {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    padding: 4rem 2rem;
    border-bottom: 1px solid var(--border-color);
}

/* Hero Section */
.hero-section {
    background: var(--bg-darker);
    position: relative;
    overflow: hidden;
}

.eva-grid {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-image: 
        linear-gradient(rgba(153, 51, 255, 0.1) 1px, transparent 1px),
        linear-gradient(90deg, rgba(153, 51, 255, 0.1) 1px, transparent 1px);
    background-size: 50px 50px;
    animation: gridMove 20s linear infinite;
}

@keyframes gridMove {
    0% { transform: translate(0, 0); }
    100% { transform: translate(50px, 50px); }
}

.hero-content {
    position: relative;
    z-index: 2;
    text-align: center;
}

.hero-title {
    font-size: clamp(4rem, 15vw, 12rem);
    font-weight: 900;
    letter-spacing: 1rem;
    color: var(--text-primary);
    text-transform: uppercase;
    margin-bottom: 1rem;
    text-shadow: 0 0 20px var(--eva-purple);
    animation: glitch 3s infinite;
}

.hero-subtitle {
    font-size: clamp(1rem, 3vw, 1.5rem);
    letter-spacing: 0.5rem;
    color: var(--text-secondary);
    text-transform: uppercase;
    border-left: 3px solid var(--eva-orange);
    padding-left: 1rem;
    display: inline-block;
}

@keyframes glitch {
    0%, 90%, 100% {
        transform: translate(0);
    }
    92% {
        transform: translate(-2px, 2px);
    }
    94% {
        transform: translate(2px, -2px);
    }
    96% {
        transform: translate(-2px, -2px);
    }
}

/* Corner Marks */
.corner-marks {
    position: absolute;
    inset: 0;
    pointer-events: none;
}

.corner {
    position: absolute;
    width: 60px;
    height: 60px;
    border: 2px solid var(--eva-purple);
}

.corner.top-left {
    top: 20px;
    left: 20px;
    border-right: none;
    border-bottom: none;
}

.corner.top-right {
    top: 20px;
    right: 20px;
    border-left: none;
    border-bottom: none;
}

.corner.bottom-left {
    bottom: 20px;
    left: 20px;
    border-right: none;
    border-top: none;
}

.corner.bottom-right {
    bottom: 20px;
    right: 20px;
    border-left: none;
    border-top: none;
}

/* Scroll Indicator */
.scroll-indicator {
    position: absolute;
    bottom: 40px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
}

.scroll-text {
    font-size: 0.8rem;
    letter-spacing: 0.2rem;
    color: var(--text-muted);
}

.scroll-line {
    width: 1px;
    height: 40px;
    background: var(--eva-purple);
    animation: scrollPulse 2s infinite;
}

@keyframes scrollPulse {
    0%, 100% { opacity: 0.3; transform: scaleY(1); }
    50% { opacity: 1; transform: scaleY(1.5); }
}

/* Section Number */
.section-number {
    position: absolute;
    top: 40px;
    left: 40px;
    font-size: 6rem;
    font-weight: 900;
    color: rgba(153, 51, 255, 0.1);
    line-height: 1;
}

/* Content Wrapper */
.content-wrapper {
    max-width: 1200px;
    width: 100%;
    position: relative;
    z-index: 2;
}

/* Section Title */
.section-title {
    font-size: clamp(2rem, 5vw, 3.5rem);
    font-weight: 900;
    letter-spacing: 0.5rem;
    margin-bottom: 3rem;
    display: flex;
    align-items: center;
    gap: 1rem;
    color: var(--text-primary);
}

.title-line {
    width: 60px;
    height: 3px;
    background: var(--eva-orange);
}

/* About Section */
.about-section {
    background: var(--bg-dark);
}

.about-content {
    margin-bottom: 3rem;
}

.about-text {
    font-size: clamp(1.1rem, 2vw, 1.4rem);
    line-height: 2;
    color: var(--text-secondary);
    margin-bottom: 2rem;
    border-left: 2px solid var(--eva-purple);
    padding-left: 2rem;
}

.warning-box {
    background: rgba(255, 255, 0, 0.05);
    border: 2px solid var(--warning-yellow);
    padding: 2rem;
    display: flex;
    align-items: center;
    gap: 1.5rem;
    margin-top: 3rem;
}

.warning-icon {
    font-size: 3rem;
    color: var(--warning-yellow);
}

.warning-box p {
    font-size: 1.1rem;
    letter-spacing: 0.1rem;
    color: var(--warning-yellow);
    font-weight: bold;
}

/* Features Section */
.features-section {
    background: var(--bg-darker);
}

.features-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 2rem;
}

.feature-card {
    background: rgba(153, 51, 255, 0.03);
    border: 1px solid var(--border-color);
    padding: 2.5rem;
    position: relative;
    transition: all 0.3s ease;
}

.feature-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 0;
    height: 2px;
    background: var(--eva-purple);
    transition: width 0.3s ease;
}

.feature-card:hover {
    border-color: var(--eva-purple);
    transform: translateY(-5px);
}

.feature-card:hover::before {
    width: 100%;
}

.feature-number {
    font-size: 3rem;
    font-weight: 900;
    color: rgba(153, 51, 255, 0.3);
    line-height: 1;
    margin-bottom: 1rem;
}

.feature-title {
    font-size: 1.3rem;
    font-weight: 700;
    letter-spacing: 0.2rem;
    margin-bottom: 1rem;
    color: var(--text-primary);
}

.feature-text {
    color: var(--text-secondary);
    line-height: 1.8;
    margin-bottom: 2rem;
}

.feature-icon {
    font-size: 3rem;
    opacity: 0.5;
}

/* Social Section */
.social-section {
    background: var(--bg-dark);
}

.social-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 2rem;
}

.social-card {
    background: rgba(0, 0, 0, 0.5);
    border: 1px solid var(--border-color);
    padding: 3rem 2rem;
    text-align: center;
    text-decoration: none;
    color: var(--text-primary);
    position: relative;
    transition: all 0.3s ease;
    overflow: hidden;
}

.social-card::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 0;
    background: rgba(153, 51, 255, 0.1);
    transition: height 0.3s ease;
}

.social-card:hover {
    border-color: var(--eva-purple);
    transform: translateY(-5px);
}

.social-card:hover::after {
    height: 100%;
}

.social-icon {
    font-size: 3.5rem;
    margin-bottom: 1.5rem;
    position: relative;
    z-index: 1;
}

.social-name {
    font-size: 1.3rem;
    font-weight: 700;
    letter-spacing: 0.2rem;
    margin-bottom: 0.5rem;
    position: relative;
    z-index: 1;
}

.social-status {
    font-size: 0.8rem;
    color: var(--eva-green);
    letter-spacing: 0.1rem;
    position: relative;
    z-index: 1;
}

/* CTA Section */
.cta-section {
    background: var(--bg-darker);
    position: relative;
}

.cta-content {
    text-align: center;
}

.cta-warning {
    background: var(--bg-dark);
    border: 3px solid var(--warning-yellow);
    padding: 2rem 3rem;
    margin-bottom: 3rem;
    position: relative;
}

.warning-stripes {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: repeating-linear-gradient(
        45deg,
        transparent,
        transparent 10px,
        rgba(255, 255, 0, 0.05) 10px,
        rgba(255, 255, 0, 0.05) 20px
    );
    pointer-events: none;
}

.cta-text {
    font-size: clamp(1.5rem, 4vw, 2.5rem);
    font-weight: 900;
    letter-spacing: 0.3rem;
    color: var(--warning-yellow);
    position: relative;
    z-index: 1;
}

.cta-button {
    background: var(--eva-purple);
    color: var(--text-primary);
    border: none;
    padding: 1.5rem 4rem;
    font-size: 1.5rem;
    font-weight: 700;
    letter-spacing: 0.3rem;
    cursor: pointer;
    position: relative;
    overflow: hidden;
    transition: all 0.3s ease;
    font-family: 'Courier New', monospace;
    display: inline-flex;
    align-items: center;
    gap: 1rem;
}

.cta-button::before {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: rgba(255, 255, 255, 0.2);
    transition: left 0.3s ease;
}

.cta-button:hover {
    transform: scale(1.05);
    box-shadow: 0 0 30px rgba(153, 51, 255, 0.5);
}

.cta-button:hover::before {
    left: 100%;
}

.button-arrow {
    transition: transform 0.3s ease;
}

.cta-button:hover .button-arrow {
    transform: translateX(10px);
}

.cta-footer {
    margin-top: 4rem;
    padding-top: 2rem;
    border-top: 1px solid var(--border-color);
    color: var(--text-muted);
    font-size: 0.9rem;
    letter-spacing: 0.1rem;
}

.cta-footer p {
    margin: 0.5rem 0;
}

/* Responsive */
@media (max-width: 768px) {
    .section-number {
        font-size: 3rem;
        top: 20px;
        left: 20px;
    }
    
    .hero-title {
        letter-spacing: 0.5rem;
    }
    
    .hero-subtitle {
        letter-spacing: 0.2rem;
    }
    
    .section-title {
        letter-spacing: 0.2rem;
    }
    
    .features-grid,
    .social-grid {
        grid-template-columns: 1fr;
    }
    
    .about-text {
        padding-left: 1rem;
    }
    
    .warning-box {
        flex-direction: column;
        text-align: center;
    }
}